# Server (Meta models) — see .dev.vars.example for Cloudflare.
MODEL_API_KEY=
META_API_BASE_URL=
PORT=8787

# Browser (Supabase) — create a free project at supabase.com, run
# supabase/migrations/001_init.sql in its SQL Editor, then copy these from
# Project Settings -> API. Vite exposes only VITE_* vars to the browser.
# Without them the app still works: pantry + saved recipes stay on this device.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
