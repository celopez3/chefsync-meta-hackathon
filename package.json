{
  "name": "chefsync-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c green,orange \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --port 5173",
    "dev:api": "tsx watch server/node.ts",
    "build": "vite build",
    "start": "tsx server/node.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "@ionic/react": "^9.0.10",
    "@supabase/supabase-js": "^2.118.0",
    "hono": "^4.7.10",
    "ionicons": "^8.1.0",
    "openai": "^7.45.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.1.7",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  }
}
